# Токен HuggingFace для диаризации (примите условия pyannote/speaker-diarization-community-1)
HF_TOKEN=
# Сеть веб-интерфейса (дефолт-порт намеренно нечастый)
APP_HOST=127.0.0.1
APP_PORT=8473

# Каталоги (можно указать абсолютные пути к своим папкам; по умолчанию — внутри проекта).
# INBOX_DIR — какую папку отслеживать; OUTPUT_DIR — куда писать результаты.
#INBOX_DIR=C:\Users\me\Videos\Записи встреч
#OUTPUT_DIR=C:\Users\me\Documents\Транскрипты
#PROCESSED_DIR=C:\Users\me\Videos\Обработанные
# Переносить обработанные из INBOX в PROCESSED. Поставь false, если отслеживаешь
# свою «живую» папку записей и не хочешь, чтобы оригиналы перемещались.
MOVE_PROCESSED=true
# Watcher inbox: сколько секунд размер/время файла должны не меняться,
# прежде чем ставить в очередь (защита от захвата ещё пишущегося стрима).
# Подними до 30–60, если пишешь стримовые записи с паузами.
INBOX_QUIET_SECONDS=15
INBOX_POLL_SECONDS=2
