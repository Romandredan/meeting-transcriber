# ============================================================================
#  Настройки Meeting Transcriber.
#  Скопируй этот файл в .env и поменяй что нужно. Всё необязательно, кроме
#  HF_TOKEN (и то — только если нужна диаризация). Пустые/закомментированные
#  (#) строки берут значение по умолчанию. После правок — перезапусти .\run.ps1
# ============================================================================

# --- ДИАРИЗАЦИЯ (разделение на «Спикер 1 / Спикер 2») ------------------------
# Ключ HuggingFace. Нужен ТОЛЬКО для диаризации. Без него транскрипция работает,
# просто без разметки спикеров. Как получить:
#   1) huggingface.co -> Settings -> Access Tokens -> New token (тип Read)
#   2) принять условия на huggingface.co/pyannote/speaker-diarization-community-1
#   3) вставить токен ниже.
HF_TOKEN=

# --- СЕТЬ (где открывается веб-интерфейс) -----------------------------------
# Адрес. 127.0.0.1 = только этот компьютер. Поставь 0.0.0.0, чтобы заходить
# с других устройств в локальной сети.
APP_HOST=127.0.0.1
# Порт (адрес интерфейса будет http://127.0.0.1:<порт>). Меняй, если 8473 занят.
APP_PORT=8473

# --- ПАПКИ ------------------------------------------------------------------
# INBOX_DIR — папка, ЗА КОТОРОЙ СЛЕДИТ программа: любой видео/аудиофайл, попавший
#   сюда, автоматически уходит на транскрипцию. Укажи свою папку записей.
# OUTPUT_DIR — КУДА КЛАДУТСЯ результаты (txt/srt/vtt/json/md/docx).
# PROCESSED_DIR — куда уезжает исходник ПОСЛЕ успешной обработки (чтобы не висел
#   в inbox и не транскрибировался повторно).
# По умолчанию — папки inbox/output/processed внутри проекта. Раскомментируй и
# впиши абсолютные пути, чтобы использовать свои.
#INBOX_DIR=C:\Users\me\Videos\Записи встреч
#OUTPUT_DIR=C:\Users\me\Documents\Транскрипты
#PROCESSED_DIR=C:\Users\me\Videos\Обработанные

# Переносить ли исходник в PROCESSED после обработки.
#   true  — переносить (inbox остаётся чистым, повторов нет);
#   false — НЕ трогать оригинал (важно, если следишь за своей «живой» папкой
#           записей и не хочешь, чтобы файлы куда-то перемещались).
MOVE_PROCESSED=true

# --- КОГДА ЗАБИРАТЬ ФАЙЛ (защита от ещё пишущегося/недокачанного) ------------
# INBOX_QUIET_SECONDS — сколько секунд файл должен «полежать без изменений»
#   (размер и дата не меняются), чтобы считать его дописанным и встать в очередь.
#   Пока идёт запись/копирование — программа ждёт, отсчёт начинается заново.
#   По умолчанию 90: положенный в inbox файл появится в очереди через ~1,5 минуты
#   тишины. Поднимай выше, если пишешь стрим с паузами дольше этого времени.
INBOX_QUIET_SECONDS=90
# INBOX_POLL_SECONDS — как часто (в секундах) проверять, не изменился ли файл.
#   Больше значение — реже проверки и позже реакция на готовый файл, меньше —
#   чаще обращения к диску. По умолчанию 30. Обычно менять не нужно.
INBOX_POLL_SECONDS=30

# --- ФОРМАТ ПРОТОКОЛА -------------------------------------------------------
# MERGE_MAX_SECONDS — макс. длина одной реплики спикера в TXT/MD/DOCX. Подряд
#   идущие фразы одного человека склеиваются в один абзац, но не длиннее этого
#   порога (чтобы длинный монолог не стал «стеной текста»). Меньше (напр. 45) —
#   короче абзацы; 0 — склеивать без ограничения. Субтитры (SRT/VTT) и JSON
#   на этот параметр не влияют — они всегда мелкие.
MERGE_MAX_SECONDS=90

# --- МОДЕЛИ -------------------------------------------------------------------
# WHISPER_MODEL — модель распознавания по умолчанию. Её же скачивает установщик.
#   large-v3-turbo — быстро (дефолт); large-v3 — точнее, но медленнее и жаднее
#   по видеопамяти; small/medium — для слабых машин без GPU.
#WHISPER_MODEL=large-v3-turbo
# PYANNOTE_PIPELINE — пайплайн диаризации. Менять, только если вышла новая версия.
#PYANNOTE_PIPELINE=pyannote/speaker-diarization-community-1

# --- АНАЛИЗ ТРАНСКРИПТА ЛОКАЛЬНОЙ LLM (стадия analyze) ----------------------
# Превращает готовую расшифровку в протокол / требования / резюме. Требует
# установленной Ollama (ollama.com) и скачанной модели: ollama pull qwen3:14b
# Запускается вручную — кнопкой «Анализ» в карточке готовой встречи.
#   false — фича выключена целиком (Ollama не нужна, всё работает как раньше).
ANALYZE_ENABLED=true
# Адрес демона Ollama. Меняй, если Ollama крутится на другой машине/порту.
LLM_BASE_URL=http://localhost:11434
# Модель. qwen3:14b проверена на реальных транскриптах и влезает в 16 ГБ VRAM.
LLM_MODEL=qwen3:14b
# Окно контекста в токенах. 32768 ≈ 78 000 символов ≈ 2,5 часа встречи.
#   Меньше VRAM (8–12 ГБ) — поставь 16384: длинные встречи всё равно
#   обработаются, просто через map-reduce (по кускам).
LLM_NUM_CTX=32768
# Температура. 0.2 — сухо и по делу; выше — «литературнее» и менее точно.
LLM_TEMPERATURE=0.2
# Сколько секунд ждать МОЛЧАНИЯ модели, прежде чем считать её зависшей.
#   Это НЕ ограничение общего времени: пока идут токены — ждём сколько угодно.
LLM_IDLE_TIMEOUT=180

# --- ПРОСТОЙ: ОСВОБОЖДЕНИЕ ВИДЕОПАМЯТИ --------------------------------------
# IDLE_UNLOAD_SECONDS — через сколько секунд простоя (нет ни расшифровок, ни
#   анализов в очереди) выгружать все модели (Whisper и LLM) из видеокарты.
#   Программа работает в фоне и запускается вместе с Windows — между встречами
#   она может простаивать часами, а модель в VRAM всё это время мешает играть,
#   работать в графике и т.п. Не ставь слишком маленькое значение: каждая
#   следующая расшифровка после выгрузки начнётся с повторной загрузки модели
#   (это единицы секунд, но на каждый файл). 0 — не выгружать вовсе.
IDLE_UNLOAD_SECONDS=300
